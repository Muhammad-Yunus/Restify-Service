# ForgeBase configuration
# Copy this file to configs/.env and adjust values for local development.
# Every setting can also be provided as an environment variable (same name).

# Server
FORGEBASE_SERVER_HOST=0.0.0.0
FORGEBASE_SERVER_PORT=8080
FORGEBASE_SERVER_ENV=development

# Database
FORGEBASE_DATABASE_URL=postgres://user:pass@localhost:5432/forgebasedb?sslmode=disable

# Redis
FORGEBASE_REDIS_URL=redis://localhost:6379/0

# RabbitMQ
FORGEBASE_RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# SMTP
FORGEBASE_SMTP_HOST=smtp.gmail.com
FORGEBASE_SMTP_PORT=587
FORGEBASE_SMTP_USER=your-email@gmail.com
FORGEBASE_SMTP_PASS=your-app-password

# EMQX MQTT
FORGEBASE_EMQX_URL=tcp://localhost:1883

# JWT
FORGEBASE_JWT_SECRET=change-me-in-production
FORGEBASE_JWT_EXPIRATION=24h

# Logging
FORGEBASE_LOGGING_LEVEL=info
FORGEBASE_LOGGING_FORMAT=json

# OpenTelemetry
FORGEBASE_OTEL_ENABLED=false
FORGEBASE_OTEL_ENDPOINT=http://localhost:4317
